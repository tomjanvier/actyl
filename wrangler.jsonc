{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker de production pour Actyl (Next.js via @opennextjs/cloudflare).
  // Les secrets ne sont JAMAIS stockés ici : `wrangler secret put` + `.dev.vars` en local.
  "name": "actyl-cloudflare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "migrations": [{ "tag": "actyl-cache-v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "actyl-next-cache" }],
  "durable_objects": { "bindings": [
    { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
  ] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "actyl-cloudflare" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Déclencheur planifié : remplace le cron Vercel (`vercel.json`).
  // La route `/api/cron/reference-packs` reste protégée par CRON_SECRET.
  // ATTENTION : le traitement actuel (imports open-data, `maxDuration: 300`)
  // dépasse les limites Workers — voir CLOUDFLARE_DEPLOYMENT.md avant production.
  "triggers": {
    "crons": ["0 4 * * 1"]
  },
  // Variables PUBLIQUES uniquement (préfixe NEXT_PUBLIC_*).
  // IMPORTANT : ne jamais mettre de chaîne vide — une var vide écrase les
  // défauts du code au runtime. Omettre tant que la valeur réelle est inconnue.
  "vars": {},
  // Garde-fous de consommation : à activer sur plan Paid.
  // "limits": { "cpu_ms": 50 },
  "previews": {
    "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "actyl-next-cache-preview" }],
    "durable_objects": { "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ] },
    "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "actyl-cloudflare" }],
    "vars": {
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEmDTGdNQb85dFhe",
      "ACTYL_PREVIEW_DISABLE_SIGNUP_TURNSTILE": "true",
      "GITHUB_ISSUES_REPOSITORY": "tomjanvier/resolvehq-actyl",
      "GITHUB_APP_ID": "5798522",
      "GITHUB_APP_INSTALLATION_ID": "182888011",
      "RESOLVEHQ_API_URL": "https://help.plaidact.org"
    }
  },

  "env": {
    "preview": {
      "name": "actyl-cloudflare-preview",
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "actyl-next-cache-preview" }],
  "durable_objects": { "bindings": [
    { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
  ] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "actyl-cloudflare-preview" }],
      "vars": {
        "GITHUB_ISSUES_REPOSITORY": "tomjanvier/resolvehq-actyl",
        "GITHUB_APP_ID": "5798522",
        "GITHUB_APP_INSTALLATION_ID": "182888011",
        "RESOLVEHQ_API_URL": "https://help.plaidact.org"
      }
    },
    "production": {
      "name": "actyl-cloudflare",
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "actyl-next-cache" }],
  "durable_objects": { "bindings": [
    { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
  ] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "actyl-cloudflare" }],
      "vars": {
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEmDTGdNQb85dFhe",
        // Origine publique : base de la redirect_uri SSO
        // (`https://actyl.org/api/auth/act/callback`, à enregistrer côté Act).
        "NEXT_PUBLIC_APP_URL": "https://actyl.org",
        "GITHUB_ISSUES_REPOSITORY": "tomjanvier/resolvehq-actyl",
        "GITHUB_APP_ID": "5798522",
        "GITHUB_APP_INSTALLATION_ID": "182888011"
      },
      "routes": [
        {
          "pattern": "actyl.org",
          "custom_domain": true
        }
      ]
    }
  }
}
