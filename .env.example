# ── Database ────────────────────────────────────────────────────────────────
# Local dev (zero-config, SQLite). For Supabase / Neon / any Postgres:
#   1. prisma/schema.prisma → provider = "postgresql"
#   2. DATABASE_URL="postgresql://user:pass@host:5432/advocacyhq"
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production-0123456789abcdef"

# ── Email (optional) ────────────────────────────────────────────────────────
# With a key, interpellation emails are sent for real via Resend.
# Without it, the engine runs in SIMULATION mode (fully tracked in DB).
RESEND_API_KEY=""
EMAIL_FROM="AdvocacyHQ <noreply@advocacyhq.local>"
