# ── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ── Authentification ─────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-of-32-plus-chars"

# ── Synchronisation planifiée des packs de référence ─────────────────────────
# Configurer la même valeur aléatoire dans Vercel pour authentifier le cron.
CRON_SECRET="generate-a-random-cron-secret"

# Liste publiée affichée sur la page d'accueil (facultatif).
LANDING_DEMO_LIST_ID=""

# ── Email (facultatif) ───────────────────────────────────────────────────────
# Sans clé Resend, les envois restent simulés et tracés dans la base.
RESEND_API_KEY=""
EMAIL_FROM="Actyl <noreply@example.org>"
ACTYL_ADMIN_EMAIL="admin@actyl.org"
ACTYL_ADMIN_PASSWORD=""
ACTYL_SUPER_ADMIN_EMAIL="admin@actyl.org"
