# ── Base de données PostgreSQL (Prisma 7, config CLI : prisma.config.ts) ─────
# Local / CLI : URL DIRECTE (Neon directe pendant la transition, puis URL
# directe Prisma Postgres `postgres://...@db.prisma.io...`). `lib/db.ts`
# choisit l'adaptateur selon l'URL (Prisma Postgres / Neon HTTP / pg local).
# Worker (preview/prod) : secret `DATABASE_URL` = URL directe Prisma Postgres.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ── Authentification ─────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-of-32-plus-chars"

# Requis uniquement pour `pnpm setup`. Aucun mot de passe par défaut n'est fourni.
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL="admin@actyl.org"
SEED_ADMIN_NAME="Administrateur Actyl"
ACTYL_SUPER_ADMIN_EMAIL="admin@actyl.org"

# ── SSO via Act (fournisseur OIDC, optionnel) ────────────────────────────────
# Act authentifie via Google (comptes invités) ; Actyl suit avec un bouton
# « Se connecter avec Act » (/sign-in → /api/auth/act/start → callback).
# Sans ces variables, le bouton est masqué (login mot de passe inchangé).
# Enregistrer au préalable la redirect_uri exacte côté Act (admin Act :
# POST /api/admin/oidc/clients) — ex. pour la prod :
#   redirect-uri « https://actyl.org/api/auth/act/callback »
# avec NEXT_PUBLIC_APP_URL="https://actyl.org".
ACT_SSO_ISSUER="https://act.plaidact.org"
ACT_SSO_CLIENT_ID=""
# Vide = client public (PKCE seul). Sinon secret affiché une seule fois côté Act.
ACT_SSO_CLIENT_SECRET=""
# Dev local : Act (fournisseur) tourne sur :3000, Actyl sur :3001
# (`pnpm dev -- --port 3001`). En prod : origine publique (ex. https://actyl.org).
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Premier rattachement des nouveaux utilisateurs SSO Act. Requis en production.
# ACT_SSO_WORKSPACE_SLUG="plaid-act"
# ACT_SSO_WORKSPACE_ID=""

# ── Synchronisation planifiée des packs de référence ─────────────────────────
# Configurer la même valeur aléatoire dans Vercel pour authentifier le cron.
CRON_SECRET="generate-a-random-cron-secret"

# Cloudflare Turnstile (le secret reste strictement côté serveur).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Liste publiée affichée sur la page d'accueil (facultatif).
LANDING_DEMO_LIST_ID=""

# ── Email (facultatif) ───────────────────────────────────────────────────────
# Sans clé Resend, les envois restent simulés et tracés dans la base.
RESEND_API_KEY=""
EMAIL_FROM="Actyl <noreply@example.org>"

# ── Cloudflare Workers (déploiement) ─────────────────────────────────────────
# Secrets : `wrangler secret put <NOM> [--env preview|production]`.
# Local preview Worker : copier `.dev.vars.example` vers `.dev.vars` (gitignoré).
# Voir wrangler.jsonc (vars publiques) et CLOUDFLARE_DEPLOYMENT.md.
