// Schéma Prisma d'Actyl.
// PostgreSQL est requis en local comme en production (Neon, Supabase ou RDS).
// Renseigner DATABASE_URL puis exécuter `pnpm db:push` et `pnpm db:seed`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Espaces de travail, utilisateurs et rôles
// ─────────────────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoEmoji String   @default("🏛️")
  website   String?
  phone     String?
  createdAt DateTime @default(now())

  memberships  Membership[]
  groups       Group[]
  contacts     Contact[]
  campaigns    Campaign[]
  campaignSharesReceived SharedCampaignRef[] @relation("CampaignShareTarget")
  customFields CustomField[]
  lists        SharedList[]
  listChangeProposals ListChangeProposal[]
  templates    EmailTemplate[]
  petitions    Petition[]
  events       Event[]
  donations    Donation[]
  apiTokens    ApiToken[]
  supporters   Supporter[]
  campaignTeams CampaignTeam[]
  politicalPositions PoliticalPosition[]

  @@map("workspaces")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  jobTitle     String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships     Membership[]
  groupMembers    GroupMember[]
  privateNotes    PrivateNote[]
  privateData     ContactPrivateData[]
  assignedCards   KanbanCard[]         @relation("CardAssignee")
  assignedTasks   Task[]               @relation("TaskAssignee")
  createdTasks    Task[]               @relation("TaskCreator")
  createdContacts Contact[]            @relation("ContactCreator")
  sentEmails      SentEmail[]
  blasts          EmailBlast[]
  listChangeProposals         ListChangeProposal[] @relation("ProposalAuthor")
  reviewedListChangeProposals ListChangeProposal[] @relation("ProposalReviewer")
  politicalPositions PoliticalPosition[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  // ADMIN | CAMPAIGNER | MEMBER | OBSERVER
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groups    GroupMember[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Group {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String   @default("indigo")
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  campaigns CampaignGroup[]
  politicalPositions PoliticalPosition[]

  @@unique([workspaceId, name])
  @@map("groups")
}

model GroupMember {
  id           String @id @default(cuid())
  groupId      String
  membershipId String

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@unique([groupId, membershipId])
  @@map("group_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// Annuaire des contacts et décideurs
// ─────────────────────────────────────────────────────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  workspaceId    String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  institution    String?
  party          String?
  region         String?
  // EU | NATIONAL | REGIONAL | LOCAL | PRIVATE_SECTOR | MEDIA | CIVIL_SOCIETY
  level          String   @default("NATIONAL")
  // ALLY | FAVORABLE | UNDECIDED | TARGET | OPPOSED | UNKNOWN
  stance         String   @default("UNKNOWN")
  influenceScore Int      @default(3) // 1..5
  // Segment d'annuaire : DECISION_MAKER | MEMBER | VOLUNTEER | DONOR | SUPPORTER
  category       String   @default("DECISION_MAKER")
  bio            String?
  photoUrl       String?
  themes         String? // Thématiques séparées par des virgules
  twitter        String?
  linkedin       String?
  website        String?
  avatarColor    String   @default("slate")
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Module newsletter facultatif. Null signifie « jamais synchronisé ».
  // SUBSCRIBED | PENDING | UNSUBSCRIBED | UNKNOWN (absent de la liste)
  newsletterStatus   String?
  newsletterSyncedAt DateTime?

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("ContactCreator", fields: [createdById], references: [id])
  notes          PrivateNote[]
  orgNotes       OrgNote[]
  privateData    ContactPrivateData[]
  customValues   CustomFieldValue[]
  cards          KanbanCard[]
  listItems      ListItem[]
  receivedEmails SentEmail[]
  tasks          Task[]
  donations      Donation[]
  listChangeProposals ListChangeProposal[]
  candidateForTeams CampaignTeam[]       @relation("CampaignCandidate")
  campaignTeamMemberships CampaignTeamMember[]

  @@unique([workspaceId, firstName, lastName, institution])
  @@index([workspaceId])
  @@index([workspaceId, level])
  @@index([workspaceId, party])
  @@index([workspaceId, region])
  @@index([workspaceId, category])
  @@index([workspaceId, newsletterStatus])
  @@map("contacts")
}

/// Les valeurs de segment suivent Contact.category. DECISION_MAKER correspond
/// à l'annuaire de plaidoyer ; les autres segments sont activés par espace.
model Donation {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String?
  email       String
  name        String
  city        String?
  // Montant entier en centimes pour éviter les imprécisions (25,00 € → 2500).
  amountCents Int
  currency    String   @default("EUR")
  provider    String? // givoly | helloasso | chèque | virement…
  label       String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt])
  @@index([email])
  @@map("donations")
}

/// Jetons Bearer de l'API publique d'ingestion (/api/v1/*), notamment utilisée
/// par WordPress. Seul le condensat SHA-256 est conservé ; le jeton n'est affiché
/// en clair qu'une seule fois.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  name        String // Exemple : « Site WordPress »
  tokenHash   String    @unique // sha256 du jeton en clair
  prefix      String // Douze premiers caractères, par exemple « actyl_abc12345 »
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_tokens")
}

model PrivateNote {
  id        String   @id @default(cuid())
  contactId String
  authorId  String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("private_notes")
}

/// Données personnelles superposées à une fiche partagée et visibles uniquement
/// par leur propriétaire : note, statut et étiquettes libres.
model ContactPrivateData {
  id        String  @id @default(cuid())
  contactId String
  userId    String
  rating    Int? // Note personnelle de 1 à 5
  tags      String? // Étiquettes libres séparées par des virgules
  status    String? // Statut personnel libre

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contactId, userId])
  @@map("contact_private_data")
}

// ─────────────────────────────────────────────────────────────────────────────
// Champs personnalisés dynamiques par espace
// ─────────────────────────────────────────────────────────────────────────────

model CustomField {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // Clé technique, par exemple « committee_membership »
  label       String // Libellé affiché
  // TEXT | SELECT | MULTI_SELECT | NUMBER | DATE | RATING | BOOLEAN | URL
  type        String   @default("TEXT")
  options     String? // Tableau JSON des choix proposés
  description String?
  showInTable Boolean  @default(false)
  position    Int      @default(0)
  // Lorsqu'elle est renseignée, la propriété est réservée à une liste partagée.
  listId      String?
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      SharedList?        @relation(fields: [listId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([listId])
  @@map("custom_fields")
}

model CustomFieldValue {
  id        String  @id @default(cuid())
  fieldId   String
  contactId String
  value     String?

  field   CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([fieldId, contactId])
  @@index([contactId])
  @@map("custom_field_values")
}

// ─────────────────────────────────────────────────────────────────────────────
// Listes partagées de décideurs
// ─────────────────────────────────────────────────────────────────────────────

model SharedList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isPublished Boolean  @default(false)
  // Une valeur indique que la liste vient d'un pack de référence et peut être
  // resynchronisée en soumettant les écarts à validation.
  sourcePack  String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     ListItem[]
  fields    CustomField[]
  proposals ListChangeProposal[]
  campaignTeams CampaignTeam[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([sourcePack])
  @@map("shared_lists")
}

/// Proposition d'un membre ou d'une source publique soumise à un administrateur.
model ListChangeProposal {
  id          String   @id @default(cuid())
  listId      String
  workspaceId String
  authorId    String?
  reviewerId  String?
  contactId   String?
  action      String   // ADD | UPDATE | REMOVE | ATTRIBUTE
  origin      String   @default("MEMBER") // MEMBER | PUBLIC_SOURCE
  payload     String   // Instantané JSON des données proposées
  reason      String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  list      SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer  User?     @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([listId, status])
  @@map("list_change_proposals")
}

model ListItem {
  id        String  @id @default(cuid())
  listId    String
  contactId String
  note      String?

  list    SharedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([listId])
  @@index([contactId])
  @@map("list_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Équipes de campagne et positions politiques
// ─────────────────────────────────────────────────────────────────────────────

/// Environnement de campagne rattaché à un candidat et à une élection.
model CampaignTeam {
  id                 String   @id @default(cuid())
  workspaceId        String
  name               String
  candidateName      String
  candidateContactId String?
  listId             String?
  election           String   @default("Présidentielle 2027")
  party              String?
  politicalBloc      String?
  status             String?  // OFFICIAL | LIKELY | WATCH | UNKNOWN
  sourceLabel        String?
  sourceUrl          String?
  programUrl         String?
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  candidate Contact? @relation("CampaignCandidate", fields: [candidateContactId], references: [id], onDelete: SetNull)
  list SharedList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  members CampaignTeamMember[]
  positions PoliticalPosition[]

  @@unique([workspaceId, election, candidateName])
  @@index([workspaceId, election])
  @@index([listId])
  @@map("campaign_teams")
}

/// Fonction occupée par un contact dans une équipe de campagne.
model CampaignTeamMember {
  id           String   @id @default(cuid())
  teamId       String
  contactId    String
  role         String?
  involvement  String?
  relationship String?
  sourceLabel  String?
  sourceUrl    String?
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team    CampaignTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([teamId, contactId])
  @@index([contactId])
  @@map("campaign_team_members")
}

/// Position sourcée d'un parti ou d'une équipe sur un thème de plaidoyer.
model PoliticalPosition {
  id          String   @id @default(cuid())
  workspaceId String
  teamId      String?
  groupId     String?
  authorId    String?
  party       String?
  topic       String
  summary     String
  stance      String   @default("UNKNOWN") // FAVORABLE | MIXED | OPPOSED | UNKNOWN
  evidence    String?
  sourceLabel String?
  sourceUrl   String?
  observedAt  DateTime?
  sourceKey   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      CampaignTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, party])
  @@index([teamId])
  @@index([groupId])
  @@map("political_positions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Campagnes et pipeline kanban
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  emoji       String    @default("📣")
  // PLANNING | ACTIVE | PAUSED | WON | LOST | ARCHIVED
  status      String    @default("ACTIVE")
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  pinned      Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  cards     KanbanCard[]
  templates EmailTemplate[]
  blasts    EmailBlast[]
  squads    CampaignGroup[]
  petition  Petition?
  tasks     Task[]
  events    Event[]
  shares    SharedCampaignRef[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("campaigns")
}

/// Accès accordé par l'espace propriétaire à une autre organisation.
model SharedCampaignRef {
  id          String   @id @default(cuid())
  campaignId  String
  workspaceId String
  access      String   @default("VIEW") // VIEW | CONTRIBUTE
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace Workspace @relation("CampaignShareTarget", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, workspaceId])
  @@index([workspaceId])
  @@map("shared_campaign_refs")
}

model PipelineStage {
  id         String @id @default(cuid())
  campaignId String
  name       String
  position   Int
  // NEUTRAL | POSITIVE | NEGATIVE | ACTIVE | WON — détermine l'accent de colonne
  kind       String @default("NEUTRAL")

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  cards    KanbanCard[]

  @@unique([campaignId, name])
  @@map("pipeline_stages")
}

model KanbanCard {
  id             String   @id @default(cuid())
  campaignId     String
  stageId        String
  contactId      String
  assignedToId   String?
  role           String? // Rôle dans la campagne, par exemple « Rapporteur »
  priority       String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  expectedAction String?
  lastTouchAt    DateTime @default(now())
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("CardAssignee", fields: [assignedToId], references: [id])
  events     CardEvent[]

  @@unique([campaignId, contactId])
  @@index([stageId])
  @@index([campaignId, stageId, position])
  @@map("kanban_cards")
}

/// Historique des créations, déplacements et changements de statut des cartes.
model CardEvent {
  id          String   @id @default(cuid())
  cardId      String
  actorName   String
  // CREATED | MOVED | PRIORITY_CHANGED
  kind        String
  fromStage   String?
  toStage     String?
  detail      String?
  createdAt   DateTime @default(now())

  card KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("card_events")
}

model CampaignGroup {
  campaignId String
  groupId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
  @@map("campaign_groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// Moteur d'interpellation : modèles, envois et emails par destinataire
// ─────────────────────────────────────────────────────────────────────────────

model EmailTemplate {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  subject    String
  body       String // Accepte les {{variables}}
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  blasts      EmailBlast[]
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id])
  workspaceId String?

  @@map("email_templates")
}

/// Envoi d'un modèle d'interpellation vers un ensemble de cibles.
model EmailBlast {
  id          String   @id @default(cuid())
  campaignId  String
  templateId  String
  subject     String
  body        String
  source      String   @default("INTERNAL") // INTERNAL | PUBLIC_PAGE
  createdById String?
  createdAt   DateTime @default(now())

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template EmailTemplate @relation(fields: [templateId], references: [id])
  emails   SentEmail[]
  creator  User?         @relation(fields: [createdById], references: [id])

  @@map("email_blasts")
}

/// Email adressé à un décideur ou message d'un citoyen vers une cible.
model SentEmail {
  id         String    @id @default(cuid())
  blastId    String?
  contactId  String
  senderName String
  senderCity String?
  subject    String
  body       String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED | SIMULATED
  providerId String?
  openedAt   DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  blast   EmailBlast? @relation(fields: [blastId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id])
  userId  String?

  @@index([blastId])
  @@index([contactId])
  @@map("sent_emails")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mobilisation : pétitions, événements et tâches
// ─────────────────────────────────────────────────────────────────────────────

/// Pétition publique rattachée à une campagne.
model Petition {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String   @unique
  title       String
  description String
  goal        Int      @default(1000)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  signatures PetitionSignature[]

  @@map("petitions")
}

model PetitionSignature {
  id         String   @id @default(cuid())
  petitionId String
  name       String
  email      String
  city       String?
  createdAt  DateTime @default(now())

  petition Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)

  @@unique([petitionId, email])
  @@index([petitionId])
  @@map("petition_signatures")
}

/// Événement de terrain avec suivi des participations.
model Event {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  rsvps     EventRsvp[]

  @@index([workspaceId, startsAt])
  @@map("events")
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  // YES | NO | MAYBE
  response  String   @default("YES")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("event_rsvps")
}

/// Tâche de suivi liée à un contact.
model Task {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String?
  campaignId  String?
  assignedToId String?
  createdById String?
  title       String
  notes       String?
  dueDate     DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignee   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  creator    User?     @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([workspaceId, done])
  @@map("tasks")
}

/// Note collective visible dans l'espace, à la différence d'une PrivateNote.
model OrgNote {
  id        String   @id @default(cuid())
  contactId String
  workspaceId String
  authorId  String?
  authorName String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("org_notes")
}

/// Demandes de compte soumises à modération.
model AccountRequest {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  passwordHash String
  orgName     String
  website     String?
  phone       String?
  // PENDING | APPROVED | REJECTED
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

/// Réglages applicatifs simples sous forme clé-valeur.
model AppSetting {
  key    String @id
  value  String
}

/// Base unifiée des soutiens : signataires, auteurs d'interpellations et personnes
/// inscrites à un événement.
model Supporter {
  id         String   @id @default(cuid())
  workspaceId String
  email      String
  name       String
  city       String?
  // interpellation | petition | event (premier point de contact)
  source     String?
  // Étiquettes manuelles séparées par des virgules pour la segmentation
  tags       String?
  touchCount Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, source])
  @@index([lastSeenAt])
  @@map("supporters")
}
